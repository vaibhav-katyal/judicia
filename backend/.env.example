# ============================================================
# Judicia backend environment
# Copy this file to backend/.env and fill in the two API keys.
# Never commit backend/.env.
# ============================================================

# --- Pinecone (vector database + hosted embeddings) ---------
# Create a free key at https://app.pinecone.io
PINECONE_API_KEY=pcsk_replace_me

# You do NOT need to create the index manually. The ingest script
# creates it automatically on first run:
#   python backend/ingest_pinecone.py
PINECONE_INDEX_NAME=judicia-legal
PINECONE_NAMESPACE=legal-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Pinecone hosted embedding model. multilingual-e5-large is 1024-d
# and works well for English + Indian-language legal text.
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_EMBEDDING_DIMENSION=1024

# --- Groq (LLM for the first-aid plan) -----------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Current recommended Groq model. If it is ever decommissioned, the
# backend automatically tries the fallback models below.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,openai/gpt-oss-120b,qwen/qwen3-32b
GROQ_TIMEOUT_SECONDS=45

# --- Retrieval tuning ---------------------------------------
RAG_TOP_K=6

# --- Optional ------------------------------------------------
# PORT=8000
# JUDICIA_MODEL_PATH=C:\path\to\models\judicia-domain-model
